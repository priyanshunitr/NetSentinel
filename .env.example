# Values are examples for your shell; NetSentinel does not auto-load .env.
HOST=127.0.0.1
PORT=8080
# Run --list-interfaces and paste an exact device name here.
INTERFACE=eth0
PROMISCUOUS=false
# Optional libpcap BPF expression; live capture only.
CAPTURE_FILTER=
CHANNEL_SIZE=512

PORT_SCAN_THRESHOLD=20
PORT_SCAN_WINDOW_SECONDS=10
SYN_FLOOD_THRESHOLD=100
SYN_FLOOD_WINDOW_SECONDS=10
TRAFFIC_SPIKE_PACKET_THRESHOLD=1000
TRAFFIC_SPIKE_BYTE_THRESHOLD=10000000
TRAFFIC_WINDOW_SECONDS=10

MAX_PACKETS=1000
MAX_ALERTS=500
MAX_FLOWS=10000
FLOW_IDLE_TIMEOUT_SECONDS=60
MAX_DETECTOR_ENTRIES=2048
